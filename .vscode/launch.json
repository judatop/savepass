{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter DEV",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "preLaunchTask": "build-dev-env",
      "toolArgs": [
        "--flavor", "dev",
        "-t", "lib/main.dart"
      ]
    },
    {
      "name": "Flutter PROD",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "preLaunchTask": "build-prod-env",
      "toolArgs": [
        "--flavor", "prod",
        "-t", "lib/main.dart"
      ]
    }
  ]
}
